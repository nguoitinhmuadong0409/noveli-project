# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://novoli:strong_password@localhost:5432/novoli_db?schema=public"

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT Secrets (generate with: openssl rand -hex 64) ────────────────────
JWT_ACCESS_SECRET="replace_with_64_byte_hex_secret_1"
JWT_REFRESH_SECRET="replace_with_64_byte_hex_secret_2"

# ─── Forum Anonymity HMAC Secret ──────────────────────────────────────────
# CRITICAL: Changing this invalidates ALL existing forum identities!
# Generate with: openssl rand -hex 64
FORUM_ANONYMOUS_SECRET="replace_with_64_byte_hex_forum_secret"

# ─── Admin ownership ──────────────────────────────────────────────────────
OWNER_BIDAN="your-owner-biDanh"
# Required only when registering the initial owner account on a fresh database.
# Generate a long random value and set it privately in the hosting provider.
OWNER_SETUP_KEY=""

# ─── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys) ─
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@novoli.app"

# ─── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000"
